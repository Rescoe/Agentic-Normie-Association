# Environment variables added by the Sept 2026 "pérennisation" pass.
# This file does NOT attempt to document every existing ANA env var (Neon,
# Groq, 1min.ai, RPC, relayer, contract addresses, etc.) — see .env.local on
# the machine that already runs this app for those. Everything below is new.
# No secret values are filled in here — only names and safe examples.

# ─── Vote reliability (voting.ts) ────────────────────────────────────────────
# Fraction of ELIGIBLE members whose yes/no (not abstain) must be cast before
# a vote's majority is considered to have met quorum. Default 0.5 if unset.
ANA_VOTE_QUORUM_RATIO=0.5

# ─── LLM budget ledger / economy mode (llmLedger.ts) ─────────────────────────
# Optional monthly CALL caps (not a real-dollar budget — no verified per-
# provider price is hardcoded anywhere in this codebase). Leave unset to
# disable budget-based provider switching entirely (the default).
ANA_GROQ_MONTHLY_CALL_CAP=
ANA_ONEMINAI_MONTHLY_CALL_CAP=

# ─── External signal collection (externalSignals.ts) ─────────────────────────
# Master switch — OFF by default (0). Set to "1" to allow the daily job to
# call third-party hosts (Hacker News, OpenAlex, RSS, Europeana, GDELT) at
# all. Base/ANA's own on-chain activity is unaffected either way — it reads
# the app's own already-collected cache, not a new outbound call.
ANA_SIGNALS_ENABLED=0

# Comma-separated RSS/Atom feed URLs, checked once/day at the midnight
# orchestrator tick (only once ANA_SIGNALS_ENABLED=1). Leave unset to skip
# this source entirely.
ANA_SIGNALS_RSS_FEEDS=

# Optional — raises OpenAlex's free-tier rate limit (no key required to use
# OpenAlex at all, this just identifies the caller politely).
OPENALEX_CONTACT_EMAIL=

# Europeana and GDELT adapters are OFF by default (Europeana needs a key;
# GDELT is high-noise) — flip these to "1" to enable them.
ANA_SIGNALS_ENABLE_EUROPEANA=0
EUROPEANA_API_KEY=
ANA_SIGNALS_ENABLE_GDELT=0
